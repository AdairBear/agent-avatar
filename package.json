{
  "name": "agentic-avatar",
  "version": "0.1.0",
  "private": true,
  "description": "A living companion that makes agentic work legible: two gauges, one creature.",
  "main": "dist/main/index.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "mock": "npm run build && electron . --mock",
    "dev": "npm run build && electron . --enable-logging",
    "telemetry": "python3 -m avatar_telemetry",
    "telemetry:mock": "python3 -m avatar_telemetry --mock",
    "telemetry:once": "python3 -m avatar_telemetry --once",
    "test": "npm run smoke && npm run smoke:rive && npm run test:telemetry",
    "test:telemetry": "cd telemetry && python3 -m unittest discover -s tests",
    "smoke": "node scripts/build.mjs && node scripts/smoke-core.mjs",
    "smoke:rive": "node scripts/smoke-rive.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall:electron": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.26.4"
  }
}
