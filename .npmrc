# Supply-chain default: package lifecycle scripts (preinstall/install/postinstall/
# prepare) must NOT auto-execute on `npm install`. A single malicious transitive
# dependency is enough, and those hooks run as your user before you have read a
# line of the package's code.
#
# npm reads the NEAREST .npmrc and does not walk up the tree, so any nested
# directory that gets its own `npm install` needs its own copy of this file.
#
# Known casualty in this repo: electron's postinstall downloads the Chromium
# binary. Opt in explicitly, once, after install:
#
#     npm run postinstall:electron
#
ignore-scripts=true
